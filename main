-- System Integrity Checks
local function GetSafeParent()
    local success, _ = pcall(function()
        local test = Instance.new("Folder")
        test.Parent = CoreGui
        test:Destroy()
    end)
    if success then
        return CoreGui
    else
        return LocalPlayer:WaitForChild("PlayerGui")
    end
end

