-- 2. MENÜ KEZELÉSE (MOBIL GOMB ÉS RIGHT SHIFT)
local function toggleMenu()
    menuOpen = not menuOpen
    MenuFrame.Visible = menuOpen
end

ToggleButton.MouseButton1Click:Connect(toggleMenu)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
        toggleMenu()
    end
end)

-- Gombok kattintásai
RageButton.MouseButton1Click:Connect(function()
    ragebotEnabled = not ragebotEnabled
    if ragebotEnabled then
        RageButton.Text = "RageBot: BE"
        RageButton.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    else
        RageButton.Text = "RageBot: KI"
        RageButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    end
end)

VoidButton.MouseButton1Click:Connect(function()
    voidSpamEnabled = not voidSpamEnabled
    if voidSpamEnabled then
        VoidButton.Text = "VoidSpam: BE"
        VoidButton.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    else
        VoidButton.Text = "VoidSpam: KI"
        VoidButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    end
end)

-- 3. LEGKÖZELEBBI ELLENSÉG KERESÉSE
local function getClosestEnemy()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if not LocalPlayer.Team or player.Team ~= LocalPlayer.Team then
                    local dist = (myChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- 4. RAGEBOT ÉS VOIDSPAM LOOP
RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myHRP = myChar.HumanoidRootPart

    -- VOIDSPAM LOGIKA (Gyors le-föl teleportálás a map alá)
    if voidSpamEnabled then
        local originalCF = myHRP.CFrame
        myHRP.CFrame = myHRP.CFrame - Vector3.new(0, 200, 0) -- Teleport a Voidba
        task.wait()
        myHRP.CFrame = originalCF -- Vissza a pályára
    end

    -- RAGEBOT LOGIKA (Teleport az ellenfélre, lövés, vissza)
    if ragebotEnabled then
        local target = getClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local targetHead = target.Character.Head
            local originalCFrame = myHRP.CFrame
            
            -- Teleport az ellenfél feje fölé
            myHRP.CFrame = targetHead.CFrame * CFrame.new(0, 8, 0)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
            
            -- Lövés szimulálás
            if mouse1click then
                mouse1click()
            end
            
            task.wait(0.05)
            myHRP.CFrame = originalCFrame
        end
    end
end)
