TabBar.BorderSizePixel = 0

local Content = Instance.new("Frame")
Content.Parent = MainFrame
Content.Size = UDim2.new(1, -20, 1, -75)
Content.Position = UDim2.new(0, 10, 0, 65)
Content.BackgroundTransparency = 1

local TabFrames = {}

local function createTab(name, xPos)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabBar
    tabBtn.Size = UDim2.new(0.2, -2, 1, 0)
    tabBtn.Position = UDim2.new(xPos, 0, 0, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(45, 20, 70)
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(220, 220, 255)
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 12

    local tabFrame = Instance.new("Frame")
    tabFrame.Parent = Content
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.BackgroundTransparency = 1
    tabFrame.Visible = (name == "AIMBOT")
    TabFrames[name] = tabFrame

    tabBtn.MouseButton1Click:Connect(function()
        for _, f in pairs(TabFrames) do f.Visible = false end
        tabFrame.Visible = true
    end)
    return tabBtn
end

createTab("AIMBOT", 0)
createTab("VISUALS+", 0.2)
createTab("PLAYER", 0.4)
createTab("SECURITY", 0.6)
createTab("SCRIPTS", 0.8)

-- ---------------------------------------------------------
-- UI SEGÉDFÜGGVÉNYEK (Dobozok & Gombok)
-- ---------------------------------------------------------
local function createBox(parent, title, size, pos)
    local box = Instance.new("Frame")
    box.Parent = parent
    box.Size = size
    box.Position = pos
    box.BackgroundColor3 = Color3.fromRGB(20, 10, 32)
    box.BorderColor3 = Color3.fromRGB(80, 35, 120)

    local bTitle = Instance.new("TextLabel")
    bTitle.Parent = box
    bTitle.Size = UDim2.new(1, -10, 0, 20)
    bTitle.Position = UDim2.new(0, 5, 0, 2)
    bTitle.BackgroundTransparency = 1
    bTitle.Text = title
    bTitle.TextColor3 = Color3.fromRGB(170, 140, 230)
    bTitle.Font = Enum.Font.SourceSansBold
    bTitle.TextSize = 13
    bTitle.TextXAlignment = Enum.TextXAlignment.Left

    return box
end

local function createToggle(parent, text, posY, default, callback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(1, -10, 0, 22)
    frame.Position = UDim2.new(0, 5, 0, posY)
    frame.BackgroundTransparency = 1

    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.Size = UDim2.new(0, 16, 0, 16)
    btn.Position = UDim2.new(0, 0, 0.1, 0)
    btn.BackgroundColor3 = default and Color3.fromRGB(150, 60, 240) or Color3.fromRGB(40, 20, 60)
    btn.BorderColor3 = Color3.fromRGB(100, 50, 150)
    btn.Text = ""

    local lbl = Instance.new("TextLabel")
    lbl.Parent = frame
    lbl.Size = UDim2.new(1, -25, 1, 0)
    lbl.Position = UDim2.new(0, 22, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(200, 200, 220)
    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(150, 60, 240) or Color3.fromRGB(40, 20, 60)
        callback(state)
    end)
end

