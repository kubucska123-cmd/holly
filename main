-- Fülek (Tabs) sávja tökéletes visszajelzéssel
local TabBar = Instance.new("Frame")
TabBar.Parent = MainFrame
TabBar.BackgroundTransparency = 1
TabBar.Position = UDim2.new(0, 8, 0, 44)
TabBar.Size = UDim2.new(1, -16, 0, 30)

local TabListLayout = Instance.new("UIListLayout")
TabListLayout.Parent = TabBar
TabListLayout.FillDirection = Enum.FillDirection.Horizontal
TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
TabListLayout.Padding = UDim.new(0, 4)

local tabs = {"Combat", "Visuals", "Skins", "Misc"}
local contentFrames = {}
local tabButtons = {}

for i, tabName in ipairs(tabs) do
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabBar
    tabBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(0, 45, 25) or Color3.fromRGB(22, 22, 22)
    tabBtn.BorderColor3 = (i == 1) and Color3.fromRGB(0, 255, 128) or Color3.fromRGB(45, 45, 45)
    tabBtn.BorderSizePixel = 1
    tabBtn.Size = UDim2.new(0.238, 0, 1, 0)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.Text = tabName
    tabBtn.TextColor3 = (i == 1) and Color3.fromRGB(0, 255, 128) or Color3.fromRGB(170, 170, 170)
    tabBtn.TextSize = 11

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 6)
    tabCorner.Parent = tabBtn

    tabButtons[tabName] = tabBtn

    local cFrame = Instance.new("ScrollingFrame")
    cFrame.Parent = MainFrame
    cFrame.BackgroundTransparency = 1
    cFrame.Position = UDim2.new(0, 10, 0, 82)
    cFrame.Size = UDim2.new(1, -20, 1, -92)
    cFrame.CanvasSize = UDim2.new(0, 0, 0, 520)
    cFrame.ScrollBarThickness = 3
    cFrame.Visible = (i == 1)
    
    local list = Instance.new("UIListLayout")
    list.Parent = cFrame
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 6)

    contentFrames[tabName] = cFrame

    tabBtn.MouseButton1Click:Connect(function()
        -- Minden tartalom elrejtése és gomb alaphelyzetbe állítása
        for name, frame in pairs(contentFrames) do
            frame.Visible = false
        end
        for name, btn in pairs(tabButtons) do
            btn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            btn.TextColor3 = Color3.fromRGB(170, 170, 170)
            btn.BorderColor3 = Color3.fromRGB(45, 45, 45)
        end
        
        -- Aktív fül megjelenítése és kiemelése
        cFrame.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(0, 45, 25)
        tabBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        tabBtn.BorderColor3 = Color3.fromRGB(0, 255, 128)
    end)
end

-- UI Segédfüggvények: Kapcsolók és Beállítások
local function AddToggle(tabName, text, toggleKey)
    local parent = contentFrames[tabName]
    if not parent then return end

    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    btn.BorderColor3 = Color3.fromRGB(35, 35, 35)
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "  " .. text .. ": [OFF]"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        getgenv().XenowareToggles[toggleKey] = not getgenv().XenowareToggles[toggleKey]
        local state = getgenv().XenowareToggles[toggleKey]
        btn.Text = "  " .. text .. ": [" .. (state and "ON" or "OFF") .. "]"
        btn.TextColor3 = state and Color3.fromRGB(0, 255, 128) or Color3.fromRGB(200, 200, 200)
        btn.BorderColor3 = state and Color3.fromRGB(0, 255, 128) or Color3.fromRGB(35, 35, 35)
    end)
end

local function AddButtonOption(tabName, text, options, optionKey)
    local parent = contentFrames[tabName]
    if not parent then return end

    local currentIndex = 1
    for i, v in ipairs(options) do
        if v == getgenv().XenowareOptions[optionKey] then currentIndex = i end
    end

    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    btn.BorderColor3 = Color3.fromRGB(35, 35, 35)
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "  " .. text .. ": < " .. tostring(getgenv().XenowareOptions[optionKey]) .. " >"
    btn.TextColor3 = Color3.fromRGB(0, 255, 128)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #options then currentIndex = 1 end
        getgenv().XenowareOptions[optionKey] = options[currentIndex]
        btn.Text = "  " .. text .. ": < " .. tostring(options[currentIndex]) .. " >"
    end)
end

