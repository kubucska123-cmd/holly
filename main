local espObjects = {}
local menuOpen = true

-- ---------------------------------------------------------
-- 1. GUI LÉTREHOZÁSA (Xenoware Tématika)
-- ---------------------------------------------------------
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Xenoware_Tapperrrr"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Felső "scriptcounter(tapperrrr)" felirat
local HUDCounter = Instance.new("TextLabel")
HUDCounter.Parent = ScreenGui
HUDCounter.Size = UDim2.new(0, 220, 0, 28)
HUDCounter.Position = UDim2.new(0.5, -110, 0.05, 0)
HUDCounter.BackgroundColor3 = Color3.fromRGB(20, 10, 30)
HUDCounter.BorderColor3 = Color3.fromRGB(140, 60, 220)
HUDCounter.BorderSizePixel = 1
HUDCounter.Text = "scriptcounter(tapperrrr)"
HUDCounter.TextColor3 = Color3.fromRGB(180, 100, 255)
HUDCounter.Font = Enum.Font.Code
HUDCounter.TextSize = 14

-- Mozgatható Mobil Toggle Gomb
local MobileToggleBtn = Instance.new("TextButton")
MobileToggleBtn.Parent = ScreenGui
MobileToggleBtn.Size = UDim2.new(0, 80, 0, 35)
MobileToggleBtn.Position = UDim2.new(0.02, 0, 0.2, 0)
MobileToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 15, 45)
MobileToggleBtn.BorderColor3 = Color3.fromRGB(160, 80, 240)
MobileToggleBtn.Text = "tapperrrr"
MobileToggleBtn.TextColor3 = Color3.fromRGB(200, 150, 255)
MobileToggleBtn.Font = Enum.Font.SourceSansBold
MobileToggleBtn.TextSize = 14
MobileToggleBtn.Active = true

-- Húzhatóság mobilra
local dragging, dragStart, startPos
MobileToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MobileToggleBtn.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MobileToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

MobileToggleBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Main Frame (Xenoware UI)
local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.Size = UDim2.new(0, 580, 0, 380)
MainFrame.Position = UDim2.new(0.5, -290, 0.5, -190)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 8, 25)
MainFrame.BorderColor3 = Color3.fromRGB(120, 40, 180)
MainFrame.BorderSizePixel = 2

-- Header
local Header = Instance.new("TextLabel")
