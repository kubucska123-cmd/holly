-- ============================================================================
-- TARGETING & COMBAT LOGIC
-- ============================================================================

local TargetEngine = {}

function TargetEngine.IsValidTarget(player)
    if not player or player == LocalPlayer then return false end
    if not player.Character then return false end

    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not rootPart then return false end
    if Config.AliveCheck and humanoid.Health <= 0 then return false end

    -- Team Check Logic
    if Config.TeamCheck and LocalPlayer.Team and player.Team then
        if LocalPlayer.Team == player.Team then return false end
    end

    return true
end

function TargetEngine.GetClosestEnemy()
    local bestTarget = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    for _, player in pairs(Players:GetPlayers()) do
        if TargetEngine.IsValidTarget(player) then
            local dist = (myChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                bestTarget = player
            end
        end
    end
    return bestTarget
end

local function HardwareClick()
    pcall(function()
        if mouse1click then
            mouse1click()
        else
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:ClickButton1(Vector2.new(0, 0))
        end
    end)
end

-- ============================================================================
-- RAGE & COMBAT LOOPS
-- ============================================================================

RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myHrp = myChar.HumanoidRootPart

    -- Knife Rage (Backstab)
    if Config.KnifeRageEnabled then
        local target = TargetEngine.GetClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = target.Character.HumanoidRootPart
            myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, Config.KnifeDistance)
            if Config.KnifeAutoSwing then HardwareClick() end
        end
    end

    -- RageBot Teleport Shot
    if Config.RageBotEnabled and not Config.KnifeRageEnabled then
        local target = TargetEngine.GetClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local targetHead = target.Character.Head
            local savedPos = myHrp.CFrame

            myHrp.CFrame = targetHead.CFrame * CFrame.new(0, Config.RageTpHeight, 0)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)

            if Config.RageAutoFire then HardwareClick() end

            task.wait(0.035)
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                myHrp.CFrame = savedPos
            end
        end
    end

    -- Void Spam Anti-Aim
    if Config.VoidSpam and not Config.RageBotEnabled and not Config.KnifeRageEnabled then
        local originalCFrame = myHrp.CFrame
        myHrp.CFrame = originalCFrame - Vector3.new(0, Config.VoidIntensity, 0)
        task.wait(0.01)
        if myChar:FindFirstChild("HumanoidRootPart") then
            myHrp.CFrame = originalCFrame
        end
    end
end)

-- Aimbot & Speed Loop
RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end

    -- SpeedHack
    local hum = myChar:FindFirstChildOfClass("Humanoid")
    if hum and Config.SpeedHack then
        hum.WalkSpeed = Config.WalkSpeedValue
    end

    -- Noclip
    if Config.Noclip then
        for _, part in pairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    -- Camera Aimbot
    if Config.AimbotEnabled and not Config.RageBotEnabled then
        local target = TargetEngine.GetClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild(Config.AimPart) then
            local aimPos = target.Character[Config.AimPart].Position
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, aimPos), Config.Smoothness)
        end
    end
end)

-- Infinite Jump
UserInputService.JumpRequest:Connect(function()
    if Config.InfJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- ============================================================================
-- VISUAL ENGINE (CHAMS / HIGHLIGHT)
-- ============================================================================

local VisualEngine = { Highlights = {} }

function VisualEngine.ApplyChams(player)
    if player == LocalPlayer then return end

    local function onChar(char)
        if not char then return end
        local hl = char:FindFirstChild("XenowareChams") or Instance.new("Highlight")
        hl.Name = "XenowareChams"
        hl.FillColor = Config.ChamsColor
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = Config.ChamsTransparency
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled = false
        hl.Parent = char
        VisualEngine.Highlights[player] = hl
    end

    if player.Character then onChar(player.Character) end
    player.CharacterAdded:Connect(onChar)
end

for _, player in pairs(Players:GetPlayers()) do VisualEngine.ApplyChams(player) end
Players.PlayerAdded:Connect(VisualEngine.ApplyChams)

RunService.RenderStepped:Connect(function()
    for player, hl in pairs(VisualEngine.Highlights) do
        if hl and hl.Parent then
            local isEnemy = TargetEngine.IsValidTarget(player)
            hl.Enabled = Config.MasterEspEnabled and Config.EspChams and isEnemy
        end
    end
end)

