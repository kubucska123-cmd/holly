-- Mobile Toggle Button
local MobileToggleBtn = Instance.new("TextButton")
MobileToggleBtn.Parent = ScreenGui
MobileToggleBtn.Size = UDim2.new(0, 85, 0, 35)
MobileToggleBtn.Position = UDim2.new(0.02, 0, 0.2, 0)
MobileToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 15, 45)
MobileToggleBtn.BorderColor3 = Color3.fromRGB(160, 80, 240)
