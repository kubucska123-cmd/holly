-- Tab & Panel Builder
function UiEngine.CreateTab(name, layoutOrder)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabBar
    tabBtn.Size = UDim2.new(0.16, -2, 1, 0)
    tabBtn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].Header
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = name
    tabBtn.TextColor3 = ThemeRegistry[Config.ActiveTheme].SubText
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 11
    tabBtn.LayoutOrder = layoutOrder

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 4)
    tabCorner.Parent = tabBtn

    local scrollContainer = Instance.new("ScrollingFrame")
    scrollContainer.Parent = ContentArea
    scrollContainer.Size = UDim2.new(1, 0, 1, 0)
    scrollContainer.BackgroundTransparency = 1
    scrollContainer.ScrollBarThickness = 4
    scrollContainer.ScrollBarImageColor3 = ThemeRegistry[Config.ActiveTheme].Accent
    scrollContainer.Visible = (layoutOrder == 1)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Parent = scrollContainer
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 6)

    UiEngine.Tabs[name] = {
        Button = tabBtn,
        Container = scrollContainer
    }

    if layoutOrder == 1 then
        UiEngine.ActiveTab = scrollContainer
        tabBtn.TextColor3 = ThemeRegistry[Config.ActiveTheme].Text
        tabBtn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].ButtonOn
    end

    tabBtn.MouseButton1Click:Connect(function()
        for _, tab in pairs(UiEngine.Tabs) do
            tab.Container.Visible = false
            tab.Button.TextColor3 = ThemeRegistry[Config.ActiveTheme].SubText
            tab.Button.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].Header
        end
        scrollContainer.Visible = true
        tabBtn.TextColor3 = ThemeRegistry[Config.ActiveTheme].Text
        tabBtn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].ButtonOn
    end)

    return scrollContainer
end

-- Interactive UI Component Builders
function UiEngine.CreateToggle(parent, text, configKey)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = parent
    toggleBtn.Size = UDim2.new(0.98, 0, 0, 34)
    local isEnabled = Config[configKey]
    toggleBtn.BackgroundColor3 = isEnabled and ThemeRegistry[Config.ActiveTheme].ButtonOn or ThemeRegistry[Config.ActiveTheme].ButtonOff
    toggleBtn.BorderColor3 = ThemeRegistry[Config.ActiveTheme].Border
    toggleBtn.BorderSizePixel = 1
    toggleBtn.Text = text .. (isEnabled and ": [BE]" or ": [KI]")
    toggleBtn.TextColor3 = isEnabled and ThemeRegistry[Config.ActiveTheme].Text or ThemeRegistry[Config.ActiveTheme].SubText
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.TextSize = 13

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = toggleBtn

    toggleBtn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        local newState = Config[configKey]
        toggleBtn.BackgroundColor3 = newState and ThemeRegistry[Config.ActiveTheme].ButtonOn or ThemeRegistry[Config.ActiveTheme].ButtonOff
        toggleBtn.Text = text .. (newState and ": [BE]" or ": [KI]")
        toggleBtn.TextColor3 = newState and ThemeRegistry[Config.ActiveTheme].Text or ThemeRegistry[Config.ActiveTheme].SubText
    end)

    table.insert(UiEngine.Elements, toggleBtn)
    return toggleBtn
end

function UiEngine.CreateButton(parent, text, callback)
    local actionBtn = Instance.new("TextButton")
    actionBtn.Parent = parent
    actionBtn.Size = UDim2.new(0.98, 0, 0, 34)
    actionBtn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].Header
    actionBtn.BorderColor3 = ThemeRegistry[Config.ActiveTheme].Accent
    actionBtn.BorderSizePixel = 1
    actionBtn.Text = text
    actionBtn.TextColor3 = ThemeRegistry[Config.ActiveTheme].Text
    actionBtn.Font = Enum.Font.SourceSansBold
    actionBtn.TextSize = 13

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = actionBtn

    actionBtn.MouseButton1Click:Connect(function()
        pcall(callback)
    end)

    table.insert(UiEngine.Elements, actionBtn)
    return actionBtn
end

