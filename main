-- =========================================================
-- MOBILE FRIENDLY TAPPERRRR UNNAMED ENCHANTMENTS & RAGEBOT
-- =========================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Beállítások / Állapotok
local menuOpen = false
local ragebotEnabled = false
local voidspamEnabled = false
local espEnabled = false
local espTracers = false

local espObjects = {}

-- 1. GUI LÉTREHOZÁSA (ResetOnSpawn = false -> meghaláskor nem tűnik el)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TapperrrrGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- HUD Felirat (Script counter)
local CounterLabel = Instance.new("TextLabel")
CounterLabel.Parent = ScreenGui
CounterLabel.Size = UDim2.new(0, 180, 0, 26)
CounterLabel.Position = UDim2.new(0.5, -90, 0.25, 0)
CounterLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
CounterLabel.BackgroundTransparency = 0.3
CounterLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
CounterLabel.Text = "scriptcounter(tapperrrr)"
CounterLabel.Font = Enum.Font.SourceSansBold
CounterLabel.TextSize = 16

local corner1 = Instance.new("UICorner")
corner1.CornerRadius = UDim.new(0, 8)
corner1.Parent = CounterLabel

---------------------------------------------------------
-- 2. MOZGATHATÓ MOBIL NYITÓGOMB (TAPPERRRR)
---------------------------------------------------------
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Parent = ScreenGui
ToggleBtn.Size = UDim2.new(0, 90, 0, 45)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.4, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
ToggleBtn.Text = "tapperrrr"
ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 14
ToggleBtn.Active = true

local cornerBtn = Instance.new("UICorner")
cornerBtn.CornerRadius = UDim.new(0, 12)
cornerBtn.Parent = ToggleBtn

local strokeBtn = Instance.new("UIStroke")
strokeBtn.Color = Color3.fromRGB(0, 255, 150)
strokeBtn.Thickness = 2
strokeBtn.Parent = ToggleBtn

-- Gomb Dragging Logika (Mobil & PC)
local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    ToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleBtn.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

---------------------------------------------------------
-- 3. FŐ MENÜ ABLAK (TAPPERRRR MENU)
---------------------------------------------------------
local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.Size = UDim2.new(0, 220, 0, 260)
MainFrame.Position = UDim2.new(0.5, -110, 0.4, -130)
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
MainFrame.Visible = false

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 10)
mainCorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "TAPPERRRR MENU"
Title.TextColor3 = Color3.fromRGB(0, 255, 150)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 18

-- Gomb készítő segédfüggvény
local function createMenuButton(name, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Size = UDim2.new(0.85, 0, 0, 35)
    btn.Position = UDim2.new(0.075, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Text = name .. ": KI"
    btn.TextColor3 = Color3.fromRGB(255, 80, 80)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.Text = name .. ": BE"
            btn.TextColor3 = Color3.fromRGB(80, 255, 80)
        else
            btn.Text = name .. ": KI"
            btn.TextColor3 = Color3.fromRGB(255, 80, 80)
        end
        callback(state)
    end)
    return btn
end

-- Menü Gombok
createMenuButton("RageBot Teleport", 40, function(val) ragebotEnabled = val end)
createMenuButton("VoidSpam", 85, function(val) voidspamEnabled = val end)
createMenuButton("Unnamed ESP", 130, function(val) espEnabled = val end)
createMenuButton("ESP Tracers", 175, function(val) espTracers = val end)

-- Menü Nyitás/Zárás (Gombon való kattintással)
ToggleBtn.MouseButton1Click:Connect(function()
    menuOpen = not menuOpen
    MainFrame.Visible = menuOpen
end)

-- Right Shift billentyű támogatás PC-seknek
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
        menuOpen = not menuOpen
        MainFrame.Visible = menuOpen
    end
end)

---------------------------------------------------------
-- 4. FUNKCIÓK LOGIKÁJA
---------------------------------------------------------

-- Legközelebbi ellenfél megkeresése
local function getClosestTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    local closest, minDist = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dist = (myChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

-- Main Heartbeat Loop (RageBot & VoidSpam)
RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myHRP = myChar.HumanoidRootPart

    -- VOID SPAM LOGIKA
    if voidspamEnabled then
        local currentCFrame = myHRP.CFrame
        myHRP.CFrame = currentCFrame - Vector3.new(0, 350, 0)
        task.wait()
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myHRP.CFrame = currentCFrame
        end
    end

    -- RAGEBOT LOGIKA
    if ragebotEnabled and not voidspamEnabled then
        local target = getClosestTarget()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local targetHead = target.Character.Head
            local savedCFrame = myHRP.CFrame

            myHRP.CFrame = targetHead.CFrame * CFrame.new(0, 7, 0)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)

            if mouse1click then mouse1click() end

            task.wait(0.03)
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                myHRP.CFrame = savedCFrame
            end
        end
    end
end)

---------------------------------------------------------
-- 5. UNNAMED ESP RENDSZER
---------------------------------------------------------
local function applyESP(player)
    if player == LocalPlayer then return end
    
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "TapperrrrESP"
    Highlight.FillColor = Color3.fromRGB(255, 0, 0)
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    Highlight.FillTransparency = 0.5
    Highlight.OutlineTransparency = 0
    Highlight.Enabled = false

    local function onCharacterAdded(char)
        Highlight.Parent = char
    end

    if player.Character then onCharacterAdded(player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)

    espObjects[player] = Highlight
end

for _, p in pairs(Players:GetPlayers()) do applyESP(p) end
Players.PlayerAdded:Connect(applyESP)

RunService.RenderStepped:Connect(function()
    for player, highlight in pairs(espObjects) do
        if highlight and player.Character then
            highlight.Enabled = espEnabled
        end
    end
end)
