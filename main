-- SKINS (BIZTONSÁGOS SKIN ÉS INVENTORY UNLOCKER)
AddActionButton("Skins", "Load Inventory & Weapon Skins", function()
    pcall(function()
        if getgc then
            for _, v in pairs(getgc(true)) do
                if typeof(v) == "table" then
                    if rawget(v, "Skins") or rawget(v, "WeaponSkins") or rawget(v, "Inventory") or rawget(v, "OwnedSkins") then
                        for k, _ in pairs(v) do
                            if type(k) == "string" then v[k] = true end
                        end
                    end
                end
            end
        end
    end)
    SendNotification("Skinek és kozmetikumok feloldva!")
end)

AddToggle("Skins", "Auto-Apply Skin Bypass Loop", "UnlockAll")

-- MISC
AddToggle("Misc", "Advanced Camera Fly", "FlyEnabled")

-- Mozgathatóság (Drag)
local function makeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position
        end
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(MainFrame)
makeDraggable(ToggleButton)

-- ==============================================================================
-- BIZTONSÁGOS HÁTTÉRFOLYAMATOK
-- ==============================================================================

local function getBestTarget()
    local bestTarget = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local localChar = LocalPlayer.Character
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    local localHRP = localChar.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and hrp then
                if getgenv().XenowareToggles.TeamCheck and player.Team == LocalPlayer.Team and player.Team ~= nil then
                    continue
                end
                
                local dist = (localHRP.Position - hrp.Position).Magnitude
                if dist <= getgenv().XenowareOptions.Distance then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if screenDist <= getgenv().XenowareOptions.FOVRadius and screenDist < shortestDist then
                            shortestDist = screenDist
                            bestTarget = player
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

-- FOV Frissítés
RunService.RenderStepped:Connect(function()
    pcall(function()
        local mousePos = UserInputService:GetMouseLocation()
        local fovSize = getgenv().XenowareOptions.FOVRadius * 2
        FOVFrame.Size = UDim2.new(0, fovSize, 0, fovSize)
        FOVFrame.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
        FOVFrame.Visible = getgenv().XenowareToggles.ShowFOV
    end)
end)

-- Aimbot & Ragebot
RunService.RenderStepped:Connect(function()
    pcall(function()
        local toggles = getgenv().XenowareToggles
        if not toggles.AimEnabled and not toggles.RageEnabled then return end

        local target = getBestTarget()
        if target and target.Character then
            local partName = getgenv().XenowareOptions.HitPart
            local part = target.Character:FindFirstChild(partName) or target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            
            if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local localHRP = LocalPlayer.Character.HumanoidRootPart
                
                if toggles.RageEnabled and not toggles.VoidSpam then
                    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        localHRP.CFrame = targetHRP.CFrame + Vector3.new(0, 5, 0)
                        pcall(function() if mouse1click then mouse1click() end end)
                    end
                end
                
                if toggles.AimEnabled and not toggles.RageEnabled then
                    local targetCF = CFrame.new(Camera.CFrame.Position, part.Position)
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, getgenv().XenowareOptions.Smoothness)
                end
            end
        end
    end)
end)

-- Void Spam
task.spawn(function()
    while true do
        task.wait(0.15)
        pcall(function()
            if getgenv().XenowareToggles.VoidSpam then
                local localChar = LocalPlayer.Character
                if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                    local hrp = localChar.HumanoidRootPart
                    local originalPos = hrp.CFrame
                    
                    local target = getBestTarget()
                    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                        local targetHRP = target.Character.HumanoidRootPart
                        hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 4, 0)
                        pcall(function() if mouse1click then mouse1click() end end)
                        task.wait(0.04)
                        hrp.CFrame = originalPos
                    end
                end
            end
        end)
    end
end)

-- Hitbox Expander
RunService.RenderStepped:Connect(function()
    pcall(function()
        if getgenv().XenowareToggles.HitboxEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    hrp.Size = Vector3.new(4, 4, 2)
                    hrp.Transparency = 0.6
                    hrp.CanCollide = false
                end
            end
        end
    end)
end)

-- Player Outline ESP
task.spawn(function()
    while true do
        task.wait(1.5)
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    if getgenv().XenowareToggles.PlayerOutline then
                        if not p.Character:FindFirstChild("XenowareOutline") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "XenowareOutline"
                            hl.Adornee = p.Character
                            hl.FillTransparency = 1
                            hl.OutlineColor = Color3.fromRGB(0, 255, 128)
                            hl.OutlineTransparency = 0
                            hl.Parent = p.Character
                        end
                    else
                        local hl = p.Character:FindFirstChild("XenowareOutline")
                        if hl then hl:Destroy() end
                    end
                end
            end
        end)
    end
end)

-- Fly
RunService.RenderStepped:Connect(function()
    pcall(function()
        if getgenv().XenowareToggles.FlyEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = true
                local moveDir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                char.HumanoidRootPart.Velocity = moveDir * getgenv().XenowareOptions.FlySpeed
            end
        else
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = false
            end
        end
    end)
end)

SendNotification("Xenoware Elite v4.0 sikeresen elindult!")
