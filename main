-- ==============================================================================
-- LOGIKÁK ÉS HÁTTÉRFOLYAMATOK
-- ==============================================================================

local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(0, 255, 128)
FOVCircle.Filled = false
FOVCircle.Transparency = 0.9

local function getBestTarget()
    local bestTarget = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local localChar = LocalPlayer.Character
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    local localHRP = localChar.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and hrp then
                if Toggles.TeamCheck and Toggles.TeamCheck.Value and player.Team == LocalPlayer.Team and player.Team ~= nil then
                    continue
                end
                
                local dist = (localHRP.Position - hrp.Position).Magnitude
                local maxDist = Options.Distance and Options.Distance.Value or 800
                
                if dist <= maxDist then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        local fovLim = Options.FOVRadius and Options.FOVRadius.Value or 150
                        
                        if screenDist <= fovLim and screenDist < shortestDist then
                            shortestDist = screenDist
                            bestTarget = player
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

-- FOV Kör frissítése
RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    FOVCircle.Position = mousePos
    FOVCircle.Radius = Options.FOVRadius and Options.FOVRadius.Value or 150
    FOVCircle.Visible = Toggles.ShowFOV and Toggles.ShowFOV.Value or false
end)

-- Aimbot, Ragebot & Status
RunService.RenderStepped:Connect(function()
    local rageActive = Toggles.RageEnabled and Toggles.RageEnabled.Value
    local voidActive = Toggles.VoidSpam and Toggles.VoidSpam.Value
    
    pcall(function()
        if rageActive then
            RageStatusLabel:SetText("Ragebot Status: Enabled [Active Hover]")
        else
            RageStatusLabel:SetText("Ragebot Status: Disabled")
        end
        
        if voidActive then
            VoidStatusLabel:SetText("Void Spam Status: Active [Looping]")
        else
            VoidStatusLabel:SetText("Void Spam Status: Disabled")
        end
    end)

    local target = getBestTarget()
    if target and target.Character then
        local hitPartName = Options.HitPart and Options.HitPart.Value or "Head"
        local part = target.Character:FindFirstChild(hitPartName) or target.Character:FindFirstChild("HumanoidRootPart")
        
        if part then
            local localChar = LocalPlayer.Character
            if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                
                if rageActive and not voidActive then
                    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        localChar.HumanoidRootPart.CFrame = targetHRP.CFrame + Vector3.new(0, 6, 0)
                        if mouse1click then mouse1click() elseif pressmousebutton1 then pressmousebutton1() end
                    end
                end
                
                if Toggles.AimEnabled and Toggles.AimEnabled.Value and not rageActive and not voidActive then
                    local targetPos = part.Position
                    local smooth = Options.AimSmooth and Options.AimSmooth.Value or 1
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), 1 / smooth)
                end
            end
        end
    end
end)

-- Void Hit & Run logika
task.spawn(function()
    while true do
        task.wait(0.15)
        if Toggles.VoidSpam and Toggles.VoidSpam.Value then
            local localChar = LocalPlayer.Character
            if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                local hrp = localChar.HumanoidRootPart
                local originalPos = hrp.CFrame
                
                local target = getBestTarget()
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHRP = target.Character.HumanoidRootPart
                    
                    hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 5, 0)
                    
                    if mouse1click then
                        mouse1click()
                    elseif pressmousebutton1 then
                        pressmousebutton1()
                    end
                    
                    task.wait(0.05)
                    hrp.CFrame = originalPos
                end
            end
        end
    end
end)

-- VR Mód Logika
RunService.RenderStepped:Connect(function()
    if Toggles.VREnabled and Toggles.VREnabled.Value then
        pcall(function()
            local vrService = game:GetService("VRService")
            -- VR beállítások érvényesítése
            Camera.CameraType = Enum.CameraType.Custom
        end)
    end
end)

-- Device Spoofer Logika (Meta / Platform szűrések hookolása)
pcall(function()
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, k)
        if Toggles.SpoofEnabled and Toggles.SpoofEnabled.Value then
            if self == UserInputService and k == "GetPlatform" then
                local selected = Options.SpoofPlatform and Options.SpoofPlatform.Value or "Computer"
                if selected == "Computer" then return Enum.Platform.Windows
                elseif selected == "Console" then return Enum.Platform.XBoxOne
                elseif selected == "Mobile" then return Enum.Platform.IOS
                elseif selected == "VR" then return Enum.Platform.Windows -- VR-hez kapcsolódó platform jelölés
                end
            end
        end
        return oldIndex(self, k)
    end)
end)

-- Silent Aim
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        if Toggles.SilentEnabled and Toggles.SilentEnabled.Value then
            if method == "Raycast" then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        if not Toggles.SilentTeamCheck.Value or player.Team ~= LocalPlayer.Team then
                            local hitPartName = Options.SilentHitPart and Options.SilentHitPart.Value or "Head"
                            local part = player.Character:FindFirstChild(hitPartName)
                            if part then
                                args[2] = (part.Position - args[1]).Unit * 1000
                            end
                        end
                    end
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end)
end)

-- Triggerbot
RunService.RenderStepped:Connect(function()
    if Toggles.TriggerEnabled and Toggles.TriggerEnabled.Value then
        local mouse = LocalPlayer:GetMouse()
        local targetPart = mouse.Target
        
        if targetPart and targetPart.Parent then
            local enemyPlayer = Players:GetPlayerFromCharacter(targetPart.Parent)
            if enemyPlayer and enemyPlayer ~= LocalPlayer then
                if not Toggles.TriggerTeamCheck.Value or enemyPlayer.Team ~= LocalPlayer.Team then
                    if mouse1click then mouse1click() elseif pressmousebutton1 then pressmousebutton1() end
                end
            end
        end
    end
end)

-- Hitbox Expander
RunService.RenderStepped:Connect(function()
    if Toggles.HitboxEnabled and Toggles.HitboxEnabled.Value then
        local scale = Options.HitboxSize and Options.HitboxSize.Value or 2.0
        local transp = Options.HitboxTrans and Options.HitboxTrans.Value or 0.6
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                hrp.Size = Vector3.new(2 * scale, 2 * scale, 1 * scale)
                hrp.Transparency = transp
                hrp.CanCollide = false
            end
        end
    end
end)

-- Fly
RunService.RenderStepped:Connect(function()
    if Toggles.FlyEnabled and Toggles.FlyEnabled.Value then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            local hrp = char.HumanoidRootPart
            char.Humanoid.PlatformStand = true
            
            local moveDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            
            local speed = Options.FlySpeed and Options.FlySpeed.Value or 60
            hrp.Velocity = moveDir * speed
        end
    else
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
    end
end)

-- Outline ESP
local function applyHighlight(char)
    if not char then return end
    if char:FindFirstChild("XenowareOutline") then return end

    local hl = Instance.new("Highlight")
    hl.Name = "XenowareOutline"
    hl.Adornee = char
    hl.FillTransparency = 1
    hl.OutlineColor = Color3.fromRGB(0, 255, 128)
    hl.OutlineTransparency = 0
    hl.Parent = char
end

task.spawn(function()
    while true do
        task.wait(1)
        if Toggles.PlayerOutline and Toggles.PlayerOutline.Value then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    applyHighlight(p.Character)
                end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hl = p.Character:FindFirstChild("XenowareOutline")
                    if hl then hl:Destroy() end
                end
            end
        end
    end
end)

Library:Notify('Xenoware // Mobile, Spoofer & VR Ready betöltődve!')
