TabBar.Size = UDim2.new(1, 0, 0, 28)

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Parent = TabBar
UIListLayout.FillDirection = Enum.FillDirection.Horizontal
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder

local tabs = {"Combat", "Visuals", "Skins", "Misc"}
local contentFrames = {}

for i, tabName in ipairs(tabs) do
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabBar
    tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    tabBtn.BorderColor3 = Color3.fromRGB(40, 40, 40)
    tabBtn.Size = UDim2.new(0.25, 0, 1, 0)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabBtn.TextSize = 11

    local cFrame = Instance.new("ScrollingFrame")
    cFrame.Parent = MainFrame
    cFrame.BackgroundTransparency = 1
    cFrame.Position = UDim2.new(0, 5, 0, 65)
    cFrame.Size = UDim2.new(1, -10, 1, -70)
    cFrame.CanvasSize = UDim2.new(0, 0, 0, 350)
    cFrame.ScrollBarThickness = 4
    cFrame.Visible = (i == 1)
    
    local list = Instance.new("UIListLayout")
    list.Parent = cFrame
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 5)

    contentFrames[tabName] = cFrame

    tabBtn.MouseButton1Click:Connect(function()
        for _, frame in pairs(contentFrames) do frame.Visible = false end
        cFrame.Visible = true
    end)
end

-- Egyszerű Mobil UIElem Készítők (Toggle-ök a gyors beállításhoz)
local function AddToggleToTab(tabName, text, toggleKey)
    local parent = contentFrames[tabName]
    if not parent then return end

    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    btn.BorderColor3 = Color3.fromRGB(0, 255, 128)
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Font = Enum.Font.Gotham
    btn.Text = "  " .. text .. ": [OFF]"
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        getgenv().XenowareToggles[toggleKey] = not getgenv().XenowareToggles[toggleKey]
        local state = getgenv().XenowareToggles[toggleKey]
        btn.Text = "  " .. text .. ": [" .. (state and "ON" or "OFF") .. "]"
        btn.TextColor3 = state and Color3.fromRGB(0, 255, 128) or Color3.fromRGB(220, 220, 220)
    end)
end

-- Funkciók hozzáadása a mobilos fülekhez
AddToggleToTab("Combat", "Aimbot Camera Lock", "AimEnabled")
AddToggleToTab("Combat", "Ragebot (Above Hover + Shoot)", "RageEnabled")
AddToggleToTab("Combat", "Void Hit & Run (Teleport Loop)", "VoidSpam")
AddToggleToTab("Combat", "Silent Aim", "SilentEnabled")
AddToggleToTab("Combat", "Triggerbot", "TriggerEnabled")
AddToggleToTab("Combat", "Hitbox Expander", "HitboxEnabled")

AddToggleToTab("Visuals", "Player Outline ESP", "PlayerOutline")
AddToggleToTab("Visuals", "Show FOV Circle", "ShowFOV")

AddToggleToTab("Skins", "Unlock All Skins & Cosmetics", "UnlockAll")

AddToggleToTab("Misc", "Advanced Fly", "FlyEnabled")
AddToggleToTab("Misc", "Device Spoofer (Platform)", "SpoofEnabled")
AddToggleToTab("Misc", "VR Mode / Sim", "VREnabled")

-- Gomb mozgatás mobilon (Drag support a főablakhoz és a nyitógombhoz is)
local function makeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(MainFrame)
makeDraggable(ToggleButton)

-- ==============================================================================
-- HÁTTÉRFOLYAMATOK ÉS FUNKCIÓK LOGIKÁJA
-- ==============================================================================

local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = false
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(0, 255, 128)
FOVCircle.Filled = false
FOVCircle.Transparency = 0.9

local function getBestTarget()
    local bestTarget = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local localChar = LocalPlayer.Character
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    local localHRP = localChar.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and hrp then
                if getgenv().XenowareToggles.TeamCheck and player.Team == LocalPlayer.Team and player.Team ~= nil then
                    continue
                end
                
                local dist = (localHRP.Position - hrp.Position).Magnitude
                if dist <= getgenv().XenowareOptions.Distance then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if screenDist <= getgenv().XenowareOptions.FOVRadius and screenDist < shortestDist then
                            shortestDist = screenDist
                            bestTarget = player
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

-- FOV Frissítés
RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    FOVCircle.Position = mousePos
    FOVCircle.Radius = getgenv().XenowareOptions.FOVRadius
    FOVCircle.Visible = getgenv().XenowareToggles.ShowFOV
end)

-- Aimbot és Ragebot
RunService.RenderStepped:Connect(function()
    local toggles = getgenv().XenowareToggles
    if not toggles.AimEnabled and not toggles.RageEnabled and not toggles.VoidSpam then return end

    local target = getBestTarget()
    if target and target.Character then
        local part = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
        if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local localHRP = LocalPlayer.Character.HumanoidRootPart
            
            -- Ragebot / Fölötte lebegés
            if toggles.RageEnabled and not toggles.VoidSpam then
                local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    localHRP.CFrame = targetHRP.CFrame + Vector3.new(0, 6, 0)
                    if mouse1click then mouse1click() elseif pressmousebutton1 then pressmousebutton1() end
                end
            end
            
            -- Tiszta Aimbot
            if toggles.AimEnabled and not toggles.RageEnabled and not toggles.VoidSpam then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, part.Position), 0.3)
            end
        end
    end
end)

-- Void Hit & Run (Void Spam): Fel a fejre -> Lő -> Vissza
task.spawn(function()
    while true do
        task.wait(0.15)
        if getgenv().XenowareToggles.VoidSpam then
            local localChar = LocalPlayer.Character
            if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                local hrp = localChar.HumanoidRootPart
                local originalPos = hrp.CFrame
                
                local target = getBestTarget()
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHRP = target.Character.HumanoidRootPart
                    
                    hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 5, 0)
                    if mouse1click then mouse1click() elseif pressmousebutton1 then pressmousebutton1() end
                    
                    task.wait(0.05)
                    hrp.CFrame = originalPos
                end
            end
        end
    end
end)

-- Skin Unlocker
task.spawn(function()
    while true do
        task.wait(2)
        if getgenv().XenowareToggles.UnlockAll then
            pcall(function()
                for _, v in pairs(getgc(true)) do
                    if typeof(v) == "table" then
                        if rawget(v, "Skins") or rawget(v, "WeaponSkins") or rawget(v, "Wraps") then
                            for key, _ in pairs(v) do v[key] = true end
                        end
                    end
                end
            end)
        end
    end
end)

-- Hitbox Expander
RunService.RenderStepped:Connect(function()
    if getgenv().XenowareToggles.HitboxEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                hrp.Size = Vector3.new(4, 4, 2)
                hrp.Transparency = 0.6
                hrp.CanCollide = false
            end
        end
    end
end)

-- Outline ESP
task.spawn(function()
    while true do
        task.wait(1)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if getgenv().XenowareToggles.PlayerOutline then
                    if not p.Character:FindFirstChild("XenowareOutline") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "XenowareOutline"
                        hl.Adornee = p.Character
                        hl.FillTransparency = 1
                        hl.OutlineColor = Color3.fromRGB(0, 255, 128)
                        hl.OutlineTransparency = 0
                        hl.Parent = p.Character
                    end
                else
                    local hl = p.Character:FindFirstChild("XenowareOutline")
                    if hl then hl:Destroy() end
                end
            end
        end
    end
end)

-- Fly Logika
RunService.RenderStepped:Connect(function()
    if getgenv().XenowareToggles.FlyEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = true
            local moveDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            char.HumanoidRootPart.Velocity = moveDir * getgenv().XenowareOptions.FlySpeed
        end
    else
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
    end
end)

-- Device Spoofer Hook
pcall(function()
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, k)
        if getgenv().XenowareToggles.SpoofEnabled and self == UserInputService and k == "GetPlatform" then
            return Enum.Platform.Windows
        end
        return oldIndex(self, k)
    end)
end)

print("Xenoware Mobile Compact Edition sikeresen betöltődött!")
