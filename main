-- Populate STYLES Category
local function ApplyThemeToUi(themeName)
    if not ThemeRegistry[themeName] then return end
    Config.ActiveTheme = themeName

    local theme = ThemeRegistry[themeName]
    MainFrame.BackgroundColor3 = theme.Background
    MainFrame.BorderColor3 = theme.Accent
    TabBar.BackgroundColor3 = theme.Header
    TopBanner.BackgroundColor3 = theme.Background
    TopBanner.BorderColor3 = theme.Accent
    BannerText.TextColor3 = theme.Text
    MobileToggleBtn.BackgroundColor3 = theme.Header
    MobileToggleBtn.BorderColor3 = theme.Accent
    MobileToggleBtn.TextColor3 = theme.Text
    HeaderTitle.Text = "TAPPERRRR ULTIMATE | Style: [" .. themeName .. "]"
    HeaderTitle.TextColor3 = theme.Text

    if DrawingEngine.FovCircle then
        DrawingEngine.FovCircle.Color = theme.Accent
    end
end

for name, _ in pairs(ThemeRegistry) do
    UiEngine.CreateButton(TabStyle, "Theme: " .. name, function()
        ApplyThemeToUi(name)
    end)
end

-- Populate CONFIG Category
UiEngine.CreateButton(TabConfig, "Save Configuration to Clipboard", function()
    if setclipboard then
        local encoded = HttpService:JSONEncode(Config)
        setclipboard(encoded)
    end
end)

UiEngine.CreateButton(TabConfig, "Execute External Holly Loadstring", function()
    pcall(function()
        loadstring(game:HttpGet(Config.HookURL))()
    end)
end)

-- Window Visibility Control
local function ToggleWindow()
    Config.MenuOpen = not Config.MenuOpen
    MainFrame.Visible = Config.MenuOpen
end

MobileToggleBtn.MouseButton1Click:Connect(ToggleWindow)

UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        ToggleWindow()
    end
end)

-- ============================================================================
-- SECTION 11: LIFECYCLE MANAGEMENT & UNLOAD HANDLER
-- ============================================================================

function XenowareUnload()
    Config.Unloaded = true
    getgenv().XenowareLoaded = false

    if ScreenGui then
        ScreenGui:Destroy()
    end

    if DrawingEngine.FovCircle then
        pcall(function() DrawingEngine.FovCircle:Remove() end)
    end

    for _, highlight in pairs(VisualEngine.Highlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
end

