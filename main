-- TÉMAVÁLTÓ (STYLES)
local function applyTheme(themeName)
    local t = Themes[themeName]
    if not t then return end
    getgenv().TapperConfig.CurrentTheme = themeName
    MainFrame.BackgroundColor3 = t.Bg
    MainFrame.BorderColor3 = t.Accent
    TabBar.BackgroundColor3 = t.Header
    HUDCounter.BackgroundColor3 = t.Bg
    HUDCounter.BorderColor3 = t.Accent
    HUDCounter.TextColor3 = t.Text
    MobileToggleBtn.BackgroundColor3 = t.Header
    MobileToggleBtn.BorderColor3 = t.Accent
    MobileToggleBtn.TextColor3 = t.Text
    Header.Text = "TAPPERRRR ULTIMATE | Style: [" .. themeName .. "]"
    Header.TextColor3 = t.Text
end

for name, _ in pairs(Themes) do
    local sBtn = Instance.new("TextButton")
    sBtn.Parent = TabStyle
    sBtn.Size = UDim2.new(0.98, 0, 0, 30)
    sBtn.BackgroundColor3 = Themes.Xenoware.Header
    sBtn.BorderColor3 = Themes.Xenoware.Accent
    sBtn.Text = "Style: " .. name
    sBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    sBtn.Font = Enum.Font.SourceSansBold
    sBtn.TextSize = 12

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = sBtn

    sBtn.MouseButton1Click:Connect(function() applyTheme(name) end)
end

