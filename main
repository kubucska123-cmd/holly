local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera
local TweenService = game:GetService("TweenService")

-- Biztonságos GUI Szülő meghatározás (mobilos executor kompatibilitás)
local CoreGui = game:GetService("CoreGui")
local guiParent = nil
pcall(function()
    if gethui then
        guiParent = gethui()
    end
end)
if not guiParent then
    pcall(function()
        guiParent = CoreGui
    end)
end
if not guiParent or not pcall(function() local f = Instance.new("Folder", guiParent) f:Destroy() end) then
    guiParent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Globális beállítások
getgenv().XenowareToggles = {
    AimEnabled = false,
    RageEnabled = false,
    TeamCheck = true,
    ShowFOV = true,
    VoidSpam = false,
    HitboxEnabled = false,
    PlayerOutline = true,
    UnlockAll = false,
    FlyEnabled = false,
}

getgenv().XenowareOptions = {
    Distance = 1000,
    FOVRadius = 150,
    Smoothness = 0.25,
    HitPart = "Head",
    FlySpeed = 50,
}

-- Előző GUI takarítása
pcall(function()
    if guiParent:FindFirstChild("XenowareMobileUI") then
        guiParent.XenowareMobileUI:Destroy()
    end
end)

