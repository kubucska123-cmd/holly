-- Értesítési Rendszer (Toast)
local NotificationFrame = Instance.new("Frame")
NotificationFrame.Name = "Notification"
NotificationFrame.Parent = ScreenGui
NotificationFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
NotificationFrame.BorderColor3 = Color3.fromRGB(0, 255, 128)
NotificationFrame.BorderSizePixel = 1
NotificationFrame.Position = UDim2.new(0.5, -125, 0, -60)
NotificationFrame.Size = UDim2.new(0, 250, 0, 38)
NotificationFrame.Visible = false

local NotifCorner = Instance.new("UICorner")
NotifCorner.CornerRadius = UDim.new(0, 8)
NotifCorner.Parent = NotificationFrame

local NotifLabel = Instance.new("TextLabel")
NotifLabel.Parent = NotificationFrame
NotifLabel.BackgroundTransparency = 1
NotifLabel.Size = UDim2.new(1, 0, 1, 0)
NotifLabel.Font = Enum.Font.GothamBold
NotifLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
NotifLabel.TextSize = 11
NotifLabel.Text = "Xenoware: Fut!"

local function SendNotification(text)
    pcall(function()
        NotifLabel.Text = text
        NotificationFrame.Position = UDim2.new(0.5, -125, 0, -60)
        NotificationFrame.Visible = true
        
        local twIn = TweenService:Create(NotificationFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -125, 0, 20)})
        twIn:Play()
        
        task.spawn(function()
            task.wait(2)
            local twOut = TweenService:Create(NotificationFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0.5, -125, 0, -60)})
            twOut:Play()
            task.wait(0.25)
            NotificationFrame.Visible = false
        end)
    end)
end

