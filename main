local Tabs = {}

local function CreateTab(name, layoutOrder)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabBar
    tabBtn.Size = UDim2.new(0.16, -2, 1, 0)
    tabBtn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].Header
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = name
    tabBtn.TextColor3 = ThemeRegistry[Config.ActiveTheme].SubText
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 11

    local scrollContainer = Instance.new("ScrollingFrame")
    scrollContainer.Parent = ContentArea
    scrollContainer.Size = UDim2.new(1, 0, 1, 0)
    scrollContainer.BackgroundTransparency = 1
    scrollContainer.ScrollBarThickness = 4
    scrollContainer.ScrollBarImageColor3 = ThemeRegistry[Config.ActiveTheme].Accent
    scrollContainer.Visible = (layoutOrder == 1)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Parent = scrollContainer
    listLayout.Padding = UDim.new(0, 6)

    Tabs[name] = { Button = tabBtn, Container = scrollContainer }

    if layoutOrder == 1 then
        tabBtn.TextColor3 = ThemeRegistry[Config.ActiveTheme].Text
        tabBtn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].ButtonOn
    end

    tabBtn.MouseButton1Click:Connect(function()
        for _, tab in pairs(Tabs) do
            tab.Container.Visible = false
            tab.Button.TextColor3 = ThemeRegistry[Config.ActiveTheme].SubText
            tab.Button.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].Header
        end
        scrollContainer.Visible = true
        tabBtn.TextColor3 = ThemeRegistry[Config.ActiveTheme].Text
        tabBtn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].ButtonOn
    end)

    return scrollContainer
end

local function CreateToggle(parent, text, configKey)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(0.98, 0, 0, 34)
    local isEnabled = Config[configKey]
    btn.BackgroundColor3 = isEnabled and ThemeRegistry[Config.ActiveTheme].ButtonOn or ThemeRegistry[Config.ActiveTheme].ButtonOff
    btn.BorderColor3 = ThemeRegistry[Config.ActiveTheme].Accent
    btn.BorderSizePixel = 1
    btn.Text = text .. (isEnabled and ": [BE]" or ": [KI]")
    btn.TextColor3 = isEnabled and ThemeRegistry[Config.ActiveTheme].Text or ThemeRegistry[Config.ActiveTheme].SubText
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        local newState = Config[configKey]
        btn.BackgroundColor3 = newState and ThemeRegistry[Config.ActiveTheme].ButtonOn or ThemeRegistry[Config.ActiveTheme].ButtonOff
        btn.Text = text .. (newState and ": [BE]" or ": [KI]")
        btn.TextColor3 = newState and ThemeRegistry[Config.ActiveTheme].Text or ThemeRegistry[Config.ActiveTheme].SubText
    end)
end

local function CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(0.98, 0, 0, 34)
    btn.BackgroundColor3 = ThemeRegistry[Config.ActiveTheme].Header
    btn.BorderColor3 = ThemeRegistry[Config.ActiveTheme].Accent
    btn.BorderSizePixel = 1
    btn.Text = text
    btn.TextColor3 = ThemeRegistry[Config.ActiveTheme].Text
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function() pcall(callback) end)
end

