local TabFrames = {}

-- Tab & Panel Készítő
local function createTab(name, order)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabBar
    tabBtn.Size = UDim2.new(0.2, -2, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(45, 20, 70)
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(220, 220, 255)
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 12
    tabBtn.LayoutOrder = order

    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Parent = Content
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.BackgroundTransparency = 1
    tabFrame.ScrollBarThickness = 4
    tabFrame.ScrollBarImageColor3 = Color3.fromRGB(140, 60, 220)
    tabFrame.Visible = (order == 1)
    
    local list = Instance.new("UIListLayout")
    list.Parent = tabFrame
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 6)
    
    TabFrames[name] = tabFrame

    tabBtn.MouseButton1Click:Connect(function()
        for _, f in pairs(TabFrames) do f.Visible = false end
        tabFrame.Visible = true
    end)
    return tabFrame
end

local TabAimbot = createTab("AIMBOT", 1)
local TabVisuals = createTab("VISUALS+", 2)
local TabPlayer = createTab("PLAYER", 3)
local TabSecurity = createTab("SECURITY", 4)
local TabScripts = createTab("SCRIPTS", 5)

-- Gomb készítő
local function createButton(parent, text, default, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(0.98, 0, 0, 32)
    btn.BackgroundColor3 = default and Color3.fromRGB(120, 40, 200) or Color3.fromRGB(30, 15, 45)
    btn.BorderColor3 = Color3.fromRGB(90, 35, 140)
    btn.Text = text .. (default and ": [BE]" or ": [KI]")
    btn.TextColor3 = default and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 200)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(120, 40, 200) or Color3.fromRGB(30, 15, 45)
        btn.Text = text .. (state and ": [BE]" or ": [KI]")
        btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 200)
        callback(state)
    end)
end

