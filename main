-- =========================================================
-- ROBLOX RIVALS OPTIMIZED: XENOWARE / KICIA / UE COUNTER
-- =========================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Védett globális állapotok
getgenv().RivalsConfig = {
    RageTp = false,
    KnifeRage = false,
    EspEnabled = false,
    AimbotEnabled = false
}

local menuOpen = true

-- 1. HUD & NYITÓGOMB (Védett CoreGui / PlayerGui)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RivalsXenoGui"
ScreenGui.ResetOnSpawn = false

local success, _ = pcall(function()
    ScreenGui.Parent = game:GetService("CoreGui")
end)
if not success then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- HUD Felső Szöveg
local HUDCounter = Instance.new("TextLabel")
HUDCounter.Parent = ScreenGui
HUDCounter.Size = UDim2.new(0, 270, 0, 30)
HUDCounter.Position = UDim2.new(0.5, -135, 0.02, 0)
HUDCounter.BackgroundColor3 = Color3.fromRGB(15, 8, 25)
HUDCounter.BorderColor3 = Color3.fromRGB(140, 60, 220)
HUDCounter.BorderSizePixel = 2
HUDCounter.Text = "XENOWARE / KICIA / UE COUNTER"
HUDCounter.TextColor3 = Color3.fromRGB(200, 150, 255)
HUDCounter.Font = Enum.Font.Code
HUDCounter.TextSize = 13

-- Mobil Nyitógomb (tapperrrr)
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Parent = ScreenGui
ToggleBtn.Size = UDim2.new(0, 85, 0, 35)
ToggleBtn.Position = UDim2.new(0.02, 0, 0.2, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(25, 12, 40)
ToggleBtn.BorderColor3 = Color3.fromRGB(140, 60, 220)
ToggleBtn.BorderSizePixel = 2
ToggleBtn.Text = "tapperrrr"
ToggleBtn.TextColor3 = Color3.fromRGB(200, 150, 255)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 14

-- 2. MENÜ ABLAK
local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.Size = UDim2.new(0, 250, 0, 220)
MainFrame.Position = UDim2.new(0.5, -125, 0.35, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 8, 25)
MainFrame.BorderColor3 = Color3.fromRGB(140, 60, 220)
MainFrame.BorderSizePixel = 2

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 35)
Title.BackgroundTransparency = 1
Title.Text = "--- RIVALS XENOWARE ---"
Title.TextColor3 = Color3.fromRGB(200, 150, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 16

-- Gomb Készítő
local function createSimpleBtn(text, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(25, 12, 40)
    btn.BorderColor3 = Color3.fromRGB(140, 60, 220)
    btn.Text = text .. ": [KI]"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and ": [BE]" or ": [KI]")
        btn.TextColor3 = state and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
        callback(state)
    end)
end

createSimpleBtn("RageBot Teleport", 45, function(v) getgenv().RivalsConfig.RageTp = v end)
createSimpleBtn("Knife Rage (Backstab)", 90, function(v) getgenv().RivalsConfig.KnifeRage = v end)
createSimpleBtn("Master ESP", 135, function(v) getgenv().RivalsConfig.EspEnabled = v end)

-- Nyitás / Zárás
ToggleBtn.MouseButton1Click:Connect(function()
    menuOpen = not menuOpen
    MainFrame.Visible = menuOpen
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
        menuOpen = not menuOpen
        MainFrame.Visible = menuOpen
    end
end)

-- LOGIKÁK (Rivals-specifikus ellenfél keresés)
local function getClosestEnemy()
    local closest, minDist = nil, math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            
            -- Rivals Csapatvizsgálat
            local isEnemy = true
            if LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then
                isEnemy = false
            end

            if hum and hum.Health > 0 and isEnemy then
                local dist = (myChar.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

-- Teleport / Movement Ciklus
RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local hrp = myChar.HumanoidRootPart

    local cfg = getgenv().RivalsConfig
    if cfg.KnifeRage or cfg.RageTp then
        local target = getClosestEnemy()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local targetHRP = target.Character.HumanoidRootPart
            local savedPos = hrp.CFrame

            if cfg.KnifeRage then
                -- Ellenfél mögé pozicionálás Rivals-ban
                hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2.5)
            elseif cfg.RageTp then
                -- Fej fölé ugrás
                hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 5.5, 0)
            end

            -- Biztonságos kattintás
            pcall(function()
                if mouse1click then mouse1click() end
            end)

            if cfg.RageTp then
                task.wait(0.04)
                if myChar:FindFirstChild("HumanoidRootPart") then
                    hrp.CFrame = savedPos
                end
            end
        end
    end
end)

-- ESP Highlight
local espObjects = {}
local function setupESP(player)
    if player == LocalPlayer then return end
    local hl = Instance.new("Highlight")
    hl.Name = "RivalsESP"
    hl.FillColor = Color3.fromRGB(160, 40, 240)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5
    hl.Enabled = false

    local function onChar(char) hl.Parent = char end
    if player.Character then onChar(player.Character) end
    player.CharacterAdded:Connect(onChar)
    espObjects[player] = hl
end

for _, p in pairs(Players:GetPlayers()) do setupESP(p) end
Players.PlayerAdded:Connect(setupESP)

RunService.RenderStepped:Connect(function()
    for p, hl in pairs(espObjects) do
        if hl then
            hl.Enabled = getgenv().RivalsConfig.EspEnabled
        end
    end
end)
