-- =========================================================
-- ROBLOX (LUAU) SCRIPT COUNTER & RAGEBOT TELEPORT
-- =========================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local menuOpen = false
local ragebotEnabled = false

-- 1. GUI LÉTREHOZÁSA (HUD & MENÜ)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TapperGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Counter Szöveg (Képernyő közepe felett)
local CounterLabel = Instance.new("TextLabel")
CounterLabel.Parent = ScreenGui
CounterLabel.Size = UDim2.new(0, 200, 0, 30)
CounterLabel.Position = UDim2.new(0.5, -100, 0.3, -15) -- Képernyő közepe felett
CounterLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
CounterLabel.BackgroundTransparency = 0.3
CounterLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
CounterLabel.Text = "scriptcounter(tapper)"
CounterLabel.Font = Enum.Font.SourceSansBold
CounterLabel.TextSize = 18

-- Menü Keret
local MenuFrame = Instance.new("Frame")
MenuFrame.Parent = ScreenGui
MenuFrame.Size = UDim2.new(0, 200, 0, 100)
MenuFrame.Position = UDim2.new(0.5, -100, 0.5, -50)
MenuFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MenuFrame.Visible = false

local MenuTitle = Instance.new("TextLabel")
MenuTitle.Parent = MenuFrame
MenuTitle.Size = UDim2.new(1, 0, 0, 30)
MenuTitle.Text = "--- MENÜ ---"
MenuTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
MenuTitle.BackgroundTransparency = 1
MenuTitle.Font = Enum.Font.SourceSansBold
MenuTitle.TextSize = 16

-- RageBot Gomb
local RageButton = Instance.new("TextButton")
RageButton.Parent = MenuFrame
RageButton.Size = UDim2.new(0.8, 0, 0, 40)
RageButton.Position = UDim2.new(0.1, 0, 0.4, 0)
RageButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
RageButton.Text = "RageBot: KI"
RageButton.TextColor3 = Color3.fromRGB(255, 255, 255)
RageButton.Font = Enum.Font.SourceSansBold
RageButton.TextSize = 16

-- 2. MENÜ MEGNYITÁSA (RIGHT SHIFT)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
        menuOpen = not menuOpen
        MenuFrame.Visible = menuOpen
    end
end)

-- Gomb kattintás
RageButton.MouseButton1Click:Connect(function()
    ragebotEnabled = not ragebotEnabled
    if ragebotEnabled then
        RageButton.Text = "RageBot: BE"
        RageButton.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    else
        RageButton.Text = "RageBot: KI"
        RageButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    end
end)

-- 3. LEGKÖZELEBBI ELLENSÉG KERESÉSE
local function getClosestEnemy()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                -- Opcionális: Csapatvizsgálat (ha van team rendszer)
                if not LocalPlayer.Team or player.Team ~= LocalPlayer.Team then
                    local dist = (myChar.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- 4. TELEPORT ÉS LÖVÉS LOGIKA
RunService.Heartbeat:Connect(function()
    if not ragebotEnabled then return end

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

    local target = getClosestEnemy()
    if target and target.Character and target.Character:FindFirstChild("Head") then
        local myHRP = myChar.HumanoidRootPart
        local targetHead = target.Character.Head
        
        -- Eredeti pozíció elmentése
        local originalCFrame = myHRP.CFrame
        
        -- Teleport az ellenség feje fölé 8 egységgel
        myHRP.CFrame = targetHead.CFrame * CFrame.new(0, 8, 0)
        
        -- Kamera fordítása az ellenfélre
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        
        -- Kattintás szimulálása (Lövés)
        if mouse1click then
            mouse1click()
        end
        
        -- Visszateleportálás az eredeti helyre
        task.wait(0.05) -- Minimális késleltetés a regisztrációhoz
        myHRP.CFrame = originalCFrame
    end
end)
