local TabFrames = {}

local function createTab(name, order)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabBar
    tabBtn.Size = UDim2.new(0.16, -2, 1, 0)
    tabBtn.BackgroundColor3 = Themes.Xenoware.Header
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(220, 220, 255)
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 11
    tabBtn.LayoutOrder = order

    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Parent = Content
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.BackgroundTransparency = 1
    tabFrame.ScrollBarThickness = 4
    tabFrame.ScrollBarImageColor3 = Themes.Xenoware.Accent
    tabFrame.Visible = (order == 1)
    
    local list = Instance.new("UIListLayout")
    list.Parent = tabFrame
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 5)
    
    TabFrames[name] = tabFrame

    tabBtn.MouseButton1Click:Connect(function()
        for _, f in pairs(TabFrames) do f.Visible = false end
        tabFrame.Visible = true
    end)
    return tabFrame
end

local TabRage = createTab("RAGE/KNIFE", 1)
local TabAimbot = createTab("AIMBOT", 2)
local TabVisuals = createTab("VISUALS", 3)
local TabPlayer = createTab("PLAYER", 4)
local TabStyle = createTab("STYLES", 5)
local TabConfig = createTab("CONFIG", 6)

-- Gomb készítő segédfüggvény
local function createButton(parent, text, key)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(0.98, 0, 0, 32)
    btn.BackgroundColor3 = getgenv().TapperConfig[key] and Themes.Xenoware.Accent or Themes.Xenoware.Header
    btn.BorderColor3 = Themes.Xenoware.Accent
    btn.BorderSizePixel = 1
    btn.Text = text .. (getgenv().TapperConfig[key] and ": [BE]" or ": [KI]")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        local state = not getgenv().TapperConfig[key]
        getgenv().TapperConfig[key] = state
        btn.BackgroundColor3 = state and Themes.Xenoware.Accent or Themes.Xenoware.Header
        btn.Text = text .. (state and ": [BE]" or ": [KI]")
    end)
    return btn
end

