-- ============================================================================
-- SECTION 4: ADVANCED MATH & RAYCAST UTILITIES
-- ============================================================================

local MathUtils = {}

function MathUtils.GetDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

function MathUtils.GetScreenPosition(worldPos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

function MathUtils.IsPointInFov(worldPos, maxRadius)
    local screenPos, onScreen = MathUtils.GetScreenPosition(worldPos)
    if not onScreen then return false, math.huge end
    local mouseLocation = UserInputService:GetMouseLocation()
    local dist = (screenPos - mouseLocation).Magnitude
    return dist <= maxRadius, dist
end

function MathUtils.IsRayVisible(origin, destination, ignoreList)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = ignoreList or {LocalPlayer.Character}
    raycastParams.IgnoreWater = true

    local direction = (destination - origin)
    local result = Workspace:Raycast(origin, direction, raycastParams)

    if result then
        return false, result.Instance
    end
    return true, nil
end

function MathUtils.PredictPosition(part, velocity, ping)
    local predictionOffset = velocity * (ping or Config.RagePrediction)
    return part.Position + predictionOffset
end

-- ============================================================================
-- SECTION 5: CUSTOM DRAWING ENGINE (FOV CIRCLE & ACCESSIBILITY)
-- ============================================================================

local DrawingEngine = {
    FovCircle = nil
}

pcall(function()
    if Drawing and Drawing.new then
        DrawingEngine.FovCircle = Drawing.new("Circle")
        DrawingEngine.FovCircle.Thickness = 1.5
        DrawingEngine.FovCircle.NumSides = 64
        DrawingEngine.FovCircle.Filled = false
        DrawingEngine.FovCircle.Transparency = 0.8
        DrawingEngine.FovCircle.Visible = false
    end
end)

function DrawingEngine.UpdateFov()
    if not DrawingEngine.FovCircle then return end
    local mouseLoc = UserInputService:GetMouseLocation()
    DrawingEngine.FovCircle.Position = mouseLoc
    DrawingEngine.FovCircle.Radius = Config.FovRadius
    DrawingEngine.FovCircle.Color = ThemeRegistry[Config.ActiveTheme].Accent
    DrawingEngine.FovCircle.Visible = Config.FovVisible and Config.AimbotEnabled
end

-- ============================================================================
-- SECTION 6: TARGETING & AIMBOT / SILENT AIM / RAGEBOT ENGINE
-- ============================================================================

local TargetEngine = {}

function TargetEngine.IsValidTarget(player)
    if not player or player == LocalPlayer then return false end
    if not player.Character then return false end

    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local targetPart = character:FindFirstChild(Config.AimPart) or rootPart

    if not humanoid or not rootPart or not targetPart then return false end
    if Config.AliveCheck and humanoid.Health <= 0 then return false end

    -- Team Check Logic
    if Config.TeamCheck and LocalPlayer.Team and player.Team then
        if LocalPlayer.Team == player.Team then
            return false
        end
    end

    -- Wall Check Logic
    if Config.WallCheck then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("Head") then
            local isVisible = MathUtils.IsRayVisible(Camera.CFrame.Position, targetPart.Position, {myChar, character})
            if not isVisible then return false end
        end
    end

    return true
end

function TargetEngine.GetBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if TargetEngine.IsValidTarget(player) then
            local character = player.Character
            local targetPart = character[Config.AimPart] or character.HumanoidRootPart

            if Config.RageTargetPriority == "Distance" then
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local dist = (myRoot.Position - targetPart.Position).Magnitude
                    if dist < bestScore then
                        bestScore = dist
                        bestTarget = player
                    end
                end
            elseif Config.RageTargetPriority == "Fov" then
                local inFov, fovDist = MathUtils.IsPointInFov(targetPart.Position, Config.FovRadius)
                if inFov and fovDist < bestScore then
                    bestScore = fovDist
                    bestTarget = player
                end
            elseif Config.RageTargetPriority == "Health" then
                local hum = character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health < bestScore then
                    bestScore = hum.Health
                    bestTarget = player
                end
            end
        end
    end

    return bestTarget
end

-- Camera Aimbot Loop
RunService.RenderStepped:Connect(function()
    DrawingEngine.UpdateFov()

    if Config.AimbotEnabled and not Config.RageBotEnabled then
        local target = TargetEngine.GetBestTarget()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild(Config.AimPart) or target.Character.HumanoidRootPart
            if aimPart then
                local targetPos = aimPart.Position
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, math.clamp(Config.Smoothness, 0.01, 1))
            end
        end
    end
end)

-- ============================================================================
-- SECTION 7: KNIFE RAGE & BACKSTAB LOGIC
-- ============================================================================

local HardwareHooks = {}

function HardwareHooks.SimulateClick()
    pcall(function()
        if mouse1click then
            mouse1click()
        elseif Input then
            Input.LeftClick()
        else
            VirtualUser = game:GetService("VirtualUser")
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(0, 0))
        end
    end)
end

local function ExecuteKnifeRage()
    if not Config.KnifeRageEnabled then return end

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myHrp = myChar.HumanoidRootPart

    local target = TargetEngine.GetBestTarget()
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local targetHrp = target.Character.HumanoidRootPart

        -- Calculate position directly behind the target
        local backstabCFrame = targetHrp.CFrame * CFrame.new(0, 0, Config.KnifeDistance)

        -- Instantly teleport to backstab position
        myHrp.CFrame = backstabCFrame

        -- Perform attack
        if Config.KnifeAutoSwing then
            HardwareHooks.SimulateClick()
        end
    end
end

local function ExecuteRageBot()
    if not Config.RageBotEnabled then return end

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myHrp = myChar.HumanoidRootPart

    local target = TargetEngine.GetBestTarget()
    if target and target.Character and target.Character:FindFirstChild("Head") then
        local targetHead = target.Character.Head
        local savedPos = myHrp.CFrame

        -- Teleport directly above target
        local rageCFrame = targetHead.CFrame * CFrame.new(0, Config.RageTpHeight, 0)
        myHrp.CFrame = rageCFrame

        -- Camera Lock
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)

        if Config.RageAutoFire then
            HardwareHooks.SimulateClick()
        end

        -- Safe Micro-Knit Restore to evade Anti-Cheat Server Snapshot
        task.wait(0.035)
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myHrp.CFrame = savedPos
        end
    end
end

RunService.Heartbeat:Connect(function()
    if Config.Unloaded then return end
    if Config.KnifeRageEnabled then
        ExecuteKnifeRage()
    elseif Config.RageBotEnabled then
        ExecuteRageBot()
    end
end)

-- ============================================================================
-- SECTION 8: VISUAL ENGINE (BOX, CHAMS, HIGHLIGHT ESP)
-- ============================================================================

local VisualEngine = {
    Highlights = {}
}

function VisualEngine.ApplyChams(player)
    if player == LocalPlayer then return end

    local function onCharacterAdded(character)
        if not character then return end

        local highlight = character:FindFirstChild("XenowareChams") or Instance.new("Highlight")
        highlight.Name = "XenowareChams"
        highlight.FillColor = Config.ChamsColor
        highlight.OutlineColor = Config.ChamsOutlineColor
        highlight.FillTransparency = Config.ChamsTransparency
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = Config.MasterEspEnabled and Config.EspChams
        highlight.Parent = character

        VisualEngine.Highlights[player] = highlight
    end

    if player.Character then
        onCharacterAdded(player.Character)
    end

    player.CharacterAdded:Connect(onCharacterAdded)
end

for _, player in pairs(Players:GetPlayers()) do
    VisualEngine.ApplyChams(player)
end

Players.PlayerAdded:Connect(function(player)
    VisualEngine.ApplyChams(player)
end)

Players.PlayerRemoving:Connect(function(player)
    VisualEngine.Highlights[player] = nil
end)

RunService.RenderStepped:Connect(function()
    if Config.Unloaded then return end
    for player, highlight in pairs(VisualEngine.Highlights) do
        if highlight and highlight.Parent then
            local isEnemy = true
            if Config.TeamCheck and LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
                isEnemy = false
            end
            highlight.Enabled = Config.MasterEspEnabled and Config.EspChams and isEnemy
            highlight.FillColor = Config.ChamsColor
        end
    end
end)

-- ============================================================================
-- SECTION 9: MOVEMENT EXPLOITS (SPEED, INF JUMP, NOCLIP, VOID SPAM)
-- ============================================================================

-- Infinite Jump Binding
UserInputService.JumpRequest:Connect(function()
    if Config.Unloaded then return end
    if Config.InfJump and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- Noclip & Speed Engine
RunService.Stepped:Connect(function()
    if Config.Unloaded then return end

    local character = LocalPlayer.Character
    if not character then return end

    -- Speed Hack
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and Config.SpeedHack then
        humanoid.WalkSpeed = Config.WalkSpeedValue
    end

    -- Noclip Engine
    if Config.Noclip then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Void Spam Engine
RunService.Heartbeat:Connect(function()
    if Config.Unloaded then return end
    if Config.VoidSpam and not Config.RageBotEnabled and not Config.KnifeRageEnabled then
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local hrp = character.HumanoidRootPart
            local originalCFrame = hrp.CFrame
            hrp.CFrame = originalCFrame - Vector3.new(0, Config.VoidIntensity, 0)
            task.wait(0.01)
            if character:FindFirstChild("HumanoidRootPart") then
                hrp.CFrame = originalCFrame
            end
        end
    end
end)

